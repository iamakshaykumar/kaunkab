---
import { langFromUrl, localize, pick, ui } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = ui(lang);
const s = pick(lang);
const L = (p: string) => localize(p, lang);
import type { Article } from '../lib/content';
import { slugOf } from '../lib/content';
import { formatDate, formatKab } from '../lib/dates';
import { isoDate } from '../lib/seo';
import { eraTitle, getEra } from '../lib/eras';
import { findImage } from '../lib/images';
import Ornament from './Ornament.astro';

interface Props {
  article: Article;
  readingMinutes: number;
  /** responsive banner variants */
  srcset?: string;
  sizes?: string;
  series?: { title: string; id: string };
}
const { article, readingMinutes, srcset, sizes, series } = Astro.props;
const d = article.data;
const updated = d.updated && d.updated.getTime() !== d.published.getTime() ? d.updated : undefined;
const era = getEra(d.era);
const img = d.image?.src ?? findImage(`lekh/${slugOf(article)}`);
---
<header class={`article-header era-${d.era}`}>
  <nav class="crumbs" aria-label={s("ब्रेडक्रम्ब", "Breadcrumb")}>
    <a href={L("/")}>{s("मुखपृष्ठ", "Home")}</a><span aria-hidden="true">/</span>
    <a href={L(`/kaal/${d.era}/`)}>{eraTitle(d.era, lang)}</a>
    {series && <><span aria-hidden="true">/</span><a href={L(`/series/${series.id}/`)}>{series.title}</a></>}
  </nav>
  <h1>{d.title}</h1>
  <Ornament align="left" />
  <p class="saar">{d.saar}</p>
  <p class="meta">
    <span class="era-chip">{lang === "en" ? era.labelEn : era.label}</span>
    <span>{formatKab(d.kab, lang)}</span>
    <span aria-hidden="true">·</span>
    <span>{s(`${readingMinutes} मिनट में पढ़ें`, `${readingMinutes} min read`)}</span>
    <span aria-hidden="true">·</span>
    <span>{d.sources.length} {s("स्रोत", d.sources.length === 1 ? "source" : "sources")}</span>
    <button type="button" class="share" data-share data-title={d.title}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v13"/></svg>
      <span data-share-label>{s("साझा करें", "Share")}</span>
    </button>
  </p>
  <p class="byline">
    {d.author && <span>{s("लेखक", "Author")}: <strong>{d.author}</strong></span>}
    {d.reviewedBy && <span>{s("तथ्य-जाँच", "Fact-checked by")}: <strong>{d.reviewedBy}</strong></span>}
    {!d.author && <span>{s("लेखन", "Written by")}: <a href={L("/parichay/#sampadan")}>{s("कौन कब संपादकीय टीम", "the Kaun Kab editorial team")}</a></span>}
    <span>{s("प्रकाशित", "Published")}: <time datetime={isoDate(d.published)}>{formatDate(d.published, lang)}</time></span>
    {updated && <span>{s("अद्यतन", "Updated")}: <time datetime={isoDate(updated)}>{formatDate(updated, lang)}</time></span>}
  </p>
  <slot />
  {img && (
    <figure class="banner">
      <img src={img} srcset={srcset} sizes={sizes} alt={d.image?.alt ?? d.title} width="1600" height="900" fetchpriority="high" />
      {d.image?.credit && <figcaption>{d.image.credit}</figcaption>}
    </figure>
  )}
</header>

<script>
  const EN = document.documentElement.lang === 'en';
  const S = (hi: string, en: string) => (EN ? en : hi);
  const P = EN ? '/en' : '';
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-share-label]')!;
    btn.addEventListener('click', async () => {
      const url = location.href.split('#')[0];
      if (navigator.share) {
        try { await navigator.share({ title: btn.dataset.title, url }); } catch {}
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        label.textContent = S('लिंक कॉपी हो गया', 'Link copied');
      } catch {
        label.textContent = S('कॉपी नहीं हो सका', 'Could not copy');
      }
      setTimeout(() => (label.textContent = S('साझा करें', 'Share')), 2200);
    });
  });
</script>

<style>
  .article-header { padding: 2.5rem 0 0; }
  .share {
    display: inline-flex; align-items: center; gap: .4rem; margin-left: auto; cursor: pointer; font: inherit; font-size: .9rem; font-weight: 600;
    padding: .35rem .85rem; background: var(--card); color: var(--fg); border: 1px solid var(--border); transition: border-color .15s, color .15s;
  }
  .share:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 560px) { .share { margin-left: 0; } }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0 .5rem; font-size: .9rem; color: var(--muted); margin-bottom: .5rem; }
  .crumbs a { color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .byline { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin: -1.25rem 0 2rem; font-size: .92rem; color: var(--muted); }
  .byline strong { color: var(--fg); font-weight: 600; }
  .share { min-height: 44px; }
  .crumbs a:hover { color: var(--accent); }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); line-height: 1.2; margin: 0 0 .25rem; max-width: 22ch; }
  .saar { font-family: var(--font-body); font-size: clamp(1.1rem, 1.8vw, 1.35rem); line-height: 1.8; color: var(--muted); max-width: 60ch; margin: 1.25rem 0 1.25rem; }
  .meta { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; color: var(--muted); font-size: .95rem; margin: 0 0 2rem; }
  .banner { margin: 0 0 3rem; }
  .banner img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border-radius: var(--radius); display: block; box-shadow: var(--shadow-lg); }
  .banner figcaption { font-size: .875rem; color: var(--muted); margin-top: .6rem; }
  @media (max-width: 700px) { .banner img { aspect-ratio: 16 / 10; } }
</style>
