---
import type { Article } from '../lib/content';
import { slugOf } from '../lib/content';
import { formatKab } from '../lib/dates';
import { eraTitle, getEra } from '../lib/eras';
import { findImage } from '../lib/images';
import Ornament from './Ornament.astro';

interface Props {
  article: Article;
  readingMinutes: number;
}
const { article, readingMinutes } = Astro.props;
const d = article.data;
const era = getEra(d.era);
const img = findImage(`lekh/${slugOf(article)}`);
---
<header class={`article-header era-${d.era}`}>
  <nav class="crumbs" aria-label="ब्रेडक्रम्ब">
    <a href="/">मुखपृष्ठ</a><span aria-hidden="true">/</span>
    <a href={`/kaal/${d.era}`}>{eraTitle(d.era)}</a>
  </nav>
  <h1>{d.title}</h1>
  <Ornament align="left" />
  <p class="saar">{d.saar}</p>
  <p class="meta">
    <span class="era-chip">{era.label}</span>
    <span>{formatKab(d.kab)}</span>
    <span aria-hidden="true">·</span>
    <span>{readingMinutes} मिनट में पढ़ें</span>
    <span aria-hidden="true">·</span>
    <span>{d.sources.length} स्रोत</span>
  </p>
  {img && (
    <figure class="banner">
      <img src={img} alt={d.image?.alt ?? d.title} width="1600" height="900" fetchpriority="high" />
      <figcaption>{d.image?.credit ?? 'चित्र: AI द्वारा बनाया गया चित्रण (सांकेतिक)'}</figcaption>
    </figure>
  )}
</header>

<style>
  .article-header { padding: 2.5rem 0 0; }
  .crumbs { display: flex; gap: .5rem; font-size: .9rem; color: var(--muted); margin-bottom: 1rem; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); line-height: 1.2; margin: 0 0 .25rem; max-width: 22ch; }
  .saar { font-family: var(--font-body); font-size: clamp(1.1rem, 1.8vw, 1.35rem); line-height: 1.8; color: var(--muted); max-width: 60ch; margin: 1.25rem 0 1.25rem; }
  .meta { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; color: var(--muted); font-size: .95rem; margin: 0 0 2rem; }
  .banner { margin: 0 0 3rem; }
  .banner img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border-radius: var(--radius); display: block; box-shadow: var(--shadow-lg); }
  .banner figcaption { font-size: .82rem; color: var(--muted); margin-top: .6rem; }
  @media (max-width: 700px) { .banner img { aspect-ratio: 16 / 10; } }
</style>
