---
import type { Article } from '../lib/content';
import { formatKab } from '../lib/dates';
import { getEra } from '../lib/eras';
import { t } from '../i18n/hi';

interface Props {
  article: Article;
  headings: { depth: number; slug: string; text: string }[];
  editHref: string;
}
const { article, headings, editHref } = Astro.props;
const d = article.data;
const toc = headings.filter((h) => h.depth === 2);
---
<aside class={`aside era-${d.era}`}>
  <div class="facts">
    <p class="kicker">एक नज़र में</p>
    <dl>
      <div><dt>{t.kab}</dt><dd>{formatKab(d.kab)}</dd></div>
      <div><dt>काल</dt><dd><a href={`/kaal/${d.era}`}>{getEra(d.era).label}</a></dd></div>
      {d.kaun?.length ? <div><dt>{t.kaun}</dt><dd>{d.kaun.join(', ')}</dd></div> : null}
      {d.kahan?.length ? <div><dt>{t.kahan}</dt><dd>{d.kahan.join(', ')}</dd></div> : null}
    </dl>
  </div>

  {toc.length > 1 && (
    <details class="toc" open data-toc-details>
      <summary><span class="kicker">इस लेख में</span><span class="count">{toc.length} भाग</span></summary>
      <nav aria-label="इस लेख में">
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}
        </ol>
      </nav>
    </details>
  )}

  <a class="edit" href={editHref} rel="noopener" target="_blank">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
    {t.editPage}
  </a>
</aside>

<script>
  const details = document.querySelector<HTMLDetailsElement>('[data-toc-details]');
  const narrow = matchMedia('(max-width: 1000px)');
  if (details) {
    // collapsed on phones/tablets, always open in the desktop sidebar
    const syncOpen = () => { details.open = !narrow.matches; };
    syncOpen();
    narrow.addEventListener('change', syncOpen);
    details.querySelector('summary')?.addEventListener('click', (e) => { if (!narrow.matches) e.preventDefault(); });
    details.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { if (narrow.matches) details.open = false; }));
  }
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  if (links.size && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.remove('active'));
            links.get(e.target.id)?.classList.add('active');
          }
        });
      },
      { rootMargin: '-90px 0px -65% 0px' },
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  .aside { display: flex; flex-direction: column; gap: 1.25rem; position: sticky; top: calc(var(--header-h) + 24px); max-height: calc(100vh - var(--header-h) - 48px); overflow-y: auto; scrollbar-width: thin; }
  .toc summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: default; margin-bottom: .5rem; }
  .toc summary::-webkit-details-marker { display: none; }
  .toc summary .kicker { margin: 0; }
  .toc .count { display: none; font-size: .82rem; color: var(--muted); }
  .facts { background: var(--card); border: 1px solid var(--border); border-top: 4px solid var(--era); border-radius: var(--radius); padding: 1.25rem 1.35rem; box-shadow: var(--shadow); }
  dl { margin: 0; display: grid; gap: .85rem; }
  dt { font-size: .78rem; font-weight: 700; letter-spacing: .05em; color: var(--muted); text-transform: uppercase; }
  dd { margin: .1rem 0 0; font-weight: 600; line-height: 1.5; }
  dd a { color: var(--era); text-decoration: none; }
  .toc { padding: 0 .25rem; }
  .toc ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--border); }
  .toc a { display: block; padding: .35rem 0 .35rem 1rem; margin-left: -2px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; font-size: .95rem; line-height: 1.5; }
  .toc a:hover { color: var(--fg); }
  .toc a.active { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }
  .edit { display: inline-flex; align-items: center; gap: .5rem; font-size: .92rem; font-weight: 600; text-decoration: none; padding: 0 .25rem; }
  .edit:hover { text-decoration: underline; }
  @media (max-width: 1000px) {
    .aside { position: static; max-height: none; overflow: visible; }
    .edit { display: none; }
    .toc { background: var(--card); border: 1px solid var(--border); padding: .85rem 1.1rem; }
    .toc summary { cursor: pointer; margin: 0; }
    .toc summary::after {
      content: ''; width: .5rem; height: .5rem; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted);
      transform: rotate(45deg) translateY(-2px); transition: transform .2s ease; flex: none;
    }
    .toc[open] summary::after { transform: rotate(-135deg); }
    .toc .count { display: inline; margin-left: auto; }
    .toc nav { margin-top: .75rem; }
  }
</style>
