---
import { t } from '../i18n/hi';
interface Props {
  sources: { title: string; url?: string }[];
}
const { sources } = Astro.props;
---
<section class="sources" aria-labelledby="sources-h">
  <h2 id="sources-h">{t.sources}</h2>
  <ol>
    {sources.map((s) => (
      <li>
        {s.url ? (
          <a href={s.url} rel="noopener" target="_blank">{s.title} <span aria-hidden="true">↗</span></a>
        ) : (
          <span>{s.title}</span>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .sources { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .sources h2 { font-size: 1.2rem; margin: 0 0 1rem; }
  ol { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: .6rem; }
  li { counter-increment: s; display: flex; gap: .75rem; color: var(--muted); font-size: .95rem; line-height: 1.6; }
  li::before { content: counter(s); flex: none; width: 1.6rem; height: 1.6rem; border-radius: 0; display: grid; place-items: center; font-size: .8rem; font-weight: 700; background: var(--bg-alt); color: var(--fg); }
  a { color: var(--fg); }
  a:hover { color: var(--accent); }
</style>
