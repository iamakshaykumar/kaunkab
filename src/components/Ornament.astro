---
interface Props {
  light?: boolean;
  align?: 'center' | 'left';
}
const { light = false, align = 'center' } = Astro.props;
---
<div class:list={['ornament', { light, left: align === 'left' }]} aria-hidden="true">
  <span class="rule"></span>
  <svg viewBox="0 0 64 28" width="64" height="28">
    <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
      <path d="M32 3c3.5 4.5 3.5 11 0 17-3.5-6-3.5-12.5 0-17z" fill="currentColor" fill-opacity=".18" />
      <path d="M32 20c-2.5-6.5-8-10-14-10 1 6 6.5 10.5 14 10z" />
      <path d="M32 20c2.5-6.5 8-10 14-10-1 6-6.5 10.5-14 10z" />
      <path d="M32 20c-5-3-11-3.5-17-1.5 4 3.5 10.5 4 17 1.5z" />
      <path d="M32 20c5-3 11-3.5 17-1.5-4 3.5-10.5 4-17 1.5z" />
      <path d="M22 24h20" />
    </g>
    <circle cx="6" cy="20" r="1.8" fill="currentColor" />
    <circle cx="58" cy="20" r="1.8" fill="currentColor" />
  </svg>
  <span class="rule"></span>
</div>

<style>
  .ornament { display: flex; align-items: center; gap: .75rem; color: var(--gold); margin: 1rem auto 0; max-width: 420px; }
  .ornament.left { margin-left: 0; max-width: 300px; }
  .ornament.left .rule:first-child { display: none; }
  .ornament.light { color: #e9c27a; }
  .rule { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, currentColor); }
  .rule:last-child { background: linear-gradient(90deg, currentColor, transparent); }
  svg { flex: none; }
</style>
