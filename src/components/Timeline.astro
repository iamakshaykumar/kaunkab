---
import { ERAS, eraRangeLabel, eraTitle } from '../lib/eras';
import { articleUrl, slugOf, type Article } from '../lib/content';
import { formatKab, formatYear } from '../lib/dates';
import { findImage } from '../lib/images';
import { findAudio, formatDuration } from '../lib/audio';
import Ornament from './Ornament.astro';

interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
const groups = ERAS.map((e) => ({ era: e, items: articles.filter((a) => a.data.era === e.id) })).filter(
  (g) => g.items.length > 0,
);
const haystack = (a: Article) =>
  [a.data.title, a.data.saar, ...(a.data.kaun ?? []), ...(a.data.kahan ?? []), formatYear(a.data.kab.start)]
    .join(' ')
    .toLowerCase();
---
<div class="tl-wrap" data-timeline>
  <div class="filters">
    <div class="chips" role="group" aria-label="काल चुनें">
      <button type="button" class="chip-btn active" data-filter="all" aria-pressed="true">सभी <span>{articles.length}</span></button>
      {groups.map((g) => (
        <button type="button" class={`chip-btn era-${g.era.id}`} data-filter={g.era.id} aria-pressed="false">
          <span class="era-dot"></span>{g.era.label} <span>{g.items.length}</span>
        </button>
      ))}
    </div>
    <label class="find">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span class="sr-only">समयरेखा में ढूँढें</span>
      <input type="search" placeholder="नाम, जगह या साल…" data-find autocomplete="off" />
    </label>
    <div class="view" role="group" aria-label="दिखाने का तरीका">
      <button type="button" class="view-btn" data-view="list" aria-pressed="false" title="छोटी सूची — कम स्क्रॉल">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        <span>सूची</span>
      </button>
      <button type="button" class="view-btn active" data-view="cards" aria-pressed="true" title="चित्र सहित कार्ड">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="4" width="18" height="7"/><rect x="3" y="14" width="18" height="7"/></svg>
        <span>कार्ड</span>
      </button>
    </div>
    <p class="status" aria-live="polite" data-status></p>
  </div>

  <a class="ab-link" href="/suno/">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"/></svg>
    <span><strong>ऑडियोबुक</strong> — सारी कहानियाँ एक के बाद एक, लगातार सुनें</span>
    <span aria-hidden="true">→</span>
  </a>

  <div class="tl" data-tl>
    {groups.map((g) => (
      <section class={`band era-${g.era.id}`} data-era={g.era.id} id={`kaal-${g.era.id}`}>
        <header class="band-head">
          <span class="band-pill">{eraRangeLabel(g.era.id)}</span>
          <h2>{eraTitle(g.era.id)}</h2>
          <Ornament />
          <p>{g.era.blurb}</p>
        </header>
        <ol class="events">
          {g.items.map((a, i) => {
            const img = findImage(`lekh/${slugOf(a)}-sm`) ?? findImage(`lekh/${slugOf(a)}`);
            const audio = findAudio(slugOf(a));
            return (
              <li class={`event ${i % 2 ? 'right' : 'left'}${audio ? ' has-audio' : ''}`} data-slug={slugOf(a)} data-text={haystack(a)}>
                <span class="year">{formatYear(a.data.kab.start)}</span>
                <span class="dot" aria-hidden="true"></span>
                <div class="ev-cell">
                <a href={articleUrl(a)} class="ev-card">
                  {img ? <img src={img} alt="" width="640" height="360" loading="lazy" decoding="async" /> : <span class="noimg" aria-hidden="true"></span>}
                  <span class="ev-body">
                    <span class="when clamp-1" title={formatKab(a.data.kab)}>{formatKab(a.data.kab)}</span>
                    <strong>{a.data.title}</strong>
                    <span class="saar">{a.data.saar}</span>
                    <span class="read">पढ़ा हुआ</span>
                  </span>
                </a>
                {audio && (
                  <button type="button" class="listen" data-listen={audio.src} data-title={a.data.title} data-href={articleUrl(a)}
                    aria-label={`"${a.data.title}" की कहानी सुनें (${formatDuration(audio.seconds)})`} title={`कहानी सुनें · ${formatDuration(audio.seconds)}`}>
                    <svg class="i-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
                    <svg class="i-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
                  </button>
                )}
                </div>
              </li>
            );
          })}
        </ol>
        <div class="more-row" data-more-row hidden>
          <button type="button" class="more-btn" data-more>और <span data-more-n></span> घटनाएँ देखें</button>
        </div>
      </section>
    ))}
    <p class="empty" hidden data-empty>कोई घटना नहीं मिली। कोई और शब्द आज़माएँ।</p>
  </div>

  <div class="mini" data-mini hidden role="region" aria-label="कहानी प्लेयर">
    <button type="button" class="m-play" data-m-play aria-label="चलाएँ / रोकें">
      <svg class="i-play" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
      <svg class="i-pause" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
    </button>
    <div class="m-body">
      <a class="m-title clamp-1" data-m-title href="#"></a>
      <input type="range" class="m-seek" data-m-seek min="0" max="100" value="0" step="0.1" aria-label="कहानी में आगे-पीछे जाएँ" />
    </div>
    <span class="m-time" data-m-time>0:00</span>
    <button type="button" class="m-next" data-m-next aria-label="अगली कहानी" title="अगली कहानी">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5.5v13l9-6.5zM16 5h2.5v14H16z"/></svg>
    </button>
    <button type="button" class="m-close" data-m-close aria-label="प्लेयर बंद करें">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <audio preload="none" data-m-audio></audio>
  </div>

  <button type="button" class="to-top" data-to-top hidden aria-label="ऊपर जाएँ" title="ऊपर जाएँ">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>
</div>

<script>
  import { browserProgress } from '../lib/progress';

  // ---- story audio: one shared mini player for all timeline events ----
  const mini = document.querySelector<HTMLElement>('[data-mini]');
  if (mini) {
    const au = mini.querySelector<HTMLAudioElement>('[data-m-audio]')!;
    const title = mini.querySelector<HTMLAnchorElement>('[data-m-title]')!;
    const seek = mini.querySelector<HTMLInputElement>('[data-m-seek]')!;
    const time = mini.querySelector<HTMLElement>('[data-m-time]')!;
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    let current: HTMLButtonElement | null = null;
    const start = (btn: HTMLButtonElement) => {
      current = btn;
      au.src = btn.dataset.listen!;
      title.textContent = btn.dataset.title!;
      title.href = btn.dataset.href!;
      mini.hidden = false;
      au.play();
    };
    // next story = the next listen button after the current one that matches the active filter/search
    const nextBtn = () => {
      const all = [...document.querySelectorAll<HTMLButtonElement>('[data-listen]')].filter(
        (b) => !b.closest('.band[hidden]') && !b.closest('.event[data-nomatch]'),
      );
      const i = current ? all.indexOf(current) : -1;
      return all[i + 1];
    };
    const playNext = () => {
      const n = nextBtn();
      if (n) start(n); else sync();
    };
    const sync = () => {
      const on = !au.paused;
      mini.classList.toggle('playing', on);
      document.querySelectorAll('.listen.playing').forEach((b) => { if (b !== current) b.classList.remove('playing'); });
      current?.classList.toggle('playing', on);
    };
    document.querySelectorAll<HTMLButtonElement>('[data-listen]').forEach((btn) =>
      btn.addEventListener('click', () => {
        if (current === btn) { if (au.paused) au.play(); else au.pause(); return; }
        start(btn);
      }),
    );
    mini.querySelector('[data-m-play]')!.addEventListener('click', () => { if (au.paused) au.play(); else au.pause(); });
    mini.querySelector('[data-m-close]')!.addEventListener('click', () => {
      au.pause(); mini.hidden = true; current?.classList.remove('playing'); current = null;
    });
    au.addEventListener('play', sync);
    au.addEventListener('pause', sync);
    au.addEventListener('ended', playNext);
    mini.querySelector('[data-m-next]')!.addEventListener('click', playNext);
    au.addEventListener('timeupdate', () => {
      if (!au.duration) return;
      const p = (au.currentTime / au.duration) * 100;
      seek.value = String(p);
      seek.style.setProperty('--p', `${p}%`);
      time.textContent = fmt(au.currentTime);
    });
    seek.addEventListener('input', () => { if (au.duration) au.currentTime = (+seek.value / 100) * au.duration; });
  }

  const read = new Set(browserProgress().getRead());
  document.querySelectorAll<HTMLElement>('.event[data-slug]').forEach((el) => {
    if (read.has(el.dataset.slug!)) el.classList.add('is-read');
  });

  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const bands = root.querySelectorAll<HTMLElement>('[data-era]');
    const find = root.querySelector<HTMLInputElement>('[data-find]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const tl = root.querySelector<HTMLElement>('[data-tl]')!;
    const LIMIT = 6;
    const expanded = new Set<string>();
    let era = 'all';

    // view mode: compact list or cards (remembered per browser)
    const viewBtns = root.querySelectorAll<HTMLButtonElement>('[data-view]');
    const setView = (v: string, save = true) => {
      tl.classList.toggle('compact', v === 'list');
      viewBtns.forEach((b) => {
        b.classList.toggle('active', b.dataset.view === v);
        b.setAttribute('aria-pressed', String(b.dataset.view === v));
      });
      if (save) try { localStorage.setItem('kaunkab:tl-view', v); } catch {}
    };
    let saved: string | null = null;
    try { saved = localStorage.getItem('kaunkab:tl-view'); } catch {}
    setView(saved === 'cards' || saved === 'list' ? saved : matchMedia('(max-width: 860px)').matches ? 'list' : 'cards', false);
    viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));

    const apply = () => {
      const q = find.value.trim().toLowerCase();
      let shown = 0;
      bands.forEach((band) => {
        const eraOk = era === 'all' || band.dataset.era === era;
        let side = 0;
        let matches = 0;
        // without a search, show only the first few events of each era until the reader asks for more
        const cap = q || expanded.has(band.dataset.era!) ? Infinity : LIMIT;
        band.querySelectorAll<HTMLElement>('.event').forEach((ev) => {
          const match = eraOk && (!q || ev.dataset.text!.includes(q));
          if (match) matches++;
          ev.toggleAttribute('data-nomatch', !match);
          const ok = match && matches <= cap;
          ev.hidden = !ok;
          if (ok) {
            // re-alternate sides so the interleaved desktop layout stays tidy after filtering
            ev.classList.toggle('left', side % 2 === 0);
            ev.classList.toggle('right', side % 2 === 1);
            side++;
          }
        });
        band.hidden = side === 0;
        shown += matches;
        const rest = matches - side;
        const row = band.querySelector<HTMLElement>('[data-more-row]')!;
        row.hidden = rest <= 0;
        row.querySelector('[data-more-n]')!.textContent = String(rest);
      });
      empty.hidden = shown > 0;
      status.textContent = q || era !== 'all' ? `${shown} घटनाएँ` : '';
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        era = b.dataset.filter!;
        buttons.forEach((x) => {
          x.classList.toggle('active', x === b);
          x.setAttribute('aria-pressed', String(x === b));
        });
        apply();
        const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
        const top = root.getBoundingClientRect().top + scrollY - headerH;
        if (scrollY > top) scrollTo({ top });
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((b) =>
      b.addEventListener('click', () => {
        const band = b.closest<HTMLElement>('[data-era]')!;
        const firstNew = band.querySelectorAll('.event:not([hidden])').length;
        expanded.add(band.dataset.era!);
        apply();
        band.querySelectorAll<HTMLElement>('.event:not([hidden]) .ev-card')[firstNew]?.focus({ preventScroll: true });
      }),
    );
    apply();

    const toTop = root.querySelector<HTMLButtonElement>('[data-to-top]')!;
    const onScroll = () => { toTop.hidden = scrollY < 900; };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    toTop.addEventListener('click', () => {
      const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
      scrollTo({ top: root.getBoundingClientRect().top + scrollY - headerH });
    });

    let t: number | undefined;
    find.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(apply, 120);
    });
  });
</script>

<style>
  .filters {
    position: sticky; top: var(--header-h); z-index: 5; display: flex; gap: .6rem 1rem; flex-wrap: wrap; align-items: center;
    padding: .8rem 0; margin-bottom: 1rem;
    background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .chips { display: flex; gap: .5rem; flex-wrap: wrap; }
  .chip-btn {
    display: inline-flex; align-items: center; gap: .4rem; font: inherit; font-size: .95rem; font-weight: 600; cursor: pointer;
    padding: .45rem 1rem; border-radius: 0; border: 1px solid var(--border); background: var(--card); color: var(--fg);
    transition: background .15s, color .15s, border-color .15s;
  }
  .chip-btn span:last-child { font-size: .875rem; opacity: .6; }
  .chip-btn:hover { border-color: var(--accent); }
  .chip-btn.active { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .chip-btn.active .era-dot { box-shadow: 0 0 0 2px var(--bg); }
  .find {
    display: flex; align-items: center; gap: .5rem; margin-left: auto; padding: 0 .85rem; min-width: 240px;
    background: var(--card); border: 1px solid var(--border); color: var(--muted); transition: border-color .15s;
  }
  .find:focus-within { border-color: var(--accent); }
  .find input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: .95rem; color: var(--fg); padding: .5rem 0; }
  .status { margin: 0; font-size: .88rem; color: var(--muted); flex-basis: 100%; }
  .status:empty { display: none; }

  .view { display: flex; border: 1px solid var(--border); background: var(--card); }
  .view-btn {
    display: inline-flex; align-items: center; gap: .35rem; font: inherit; font-size: .9rem; font-weight: 600; cursor: pointer;
    padding: .45rem .8rem; border: 0; background: transparent; color: var(--muted); min-height: 38px;
  }
  .view-btn + .view-btn { border-left: 1px solid var(--border); }
  .view-btn:hover { color: var(--fg); }
  .view-btn.active { background: var(--fg); color: var(--bg); }

  .ab-link {
    display: flex; align-items: center; gap: .75rem; margin: 0 0 .5rem; padding: .75rem 1rem; text-decoration: none; color: var(--fg);
    background: var(--card); border: 1px solid var(--border); border-left: 4px solid var(--gold); font-size: .95rem;
  }
  .ab-link svg { flex: none; color: var(--gold); }
  .ab-link span:nth-child(2) { flex: 1; }
  .ab-link:hover { border-color: var(--accent); }
  .ab-link:hover strong { color: var(--accent); }

  .more-row { text-align: center; padding: 0 0 1.5rem; position: relative; z-index: 1; }
  .more-row[hidden] { display: none; }
  .more-btn {
    font: inherit; font-weight: 700; font-size: .95rem; cursor: pointer; padding: .6rem 1.4rem; min-height: 44px;
    color: var(--era); background: var(--card); border: 2px solid var(--era);
  }
  .more-btn:hover { background: var(--era); color: var(--card); }

  .to-top {
    position: fixed; right: 1rem; bottom: 1rem; z-index: 30; width: 46px; height: 46px; border-radius: 50%; cursor: pointer;
    display: grid; place-items: center; border: 1px solid var(--border); background: var(--card); color: var(--fg); box-shadow: var(--shadow-lg);
  }
  .to-top[hidden] { display: none; }
  .to-top:hover { color: var(--accent); border-color: var(--accent); }
  :global(body:has([data-mini]:not([hidden]))) .to-top { bottom: 5.5rem; }

  .band { padding: 2rem 0 1rem; }
  .band[hidden], .event[hidden], .compact .event[hidden] { display: none; }
  .band-head { text-align: center; max-width: 640px; margin: 0 auto 2.5rem; }
  .band-pill { display: inline-block; font-size: .875rem; font-weight: 700; padding: .25rem .8rem; border-radius: 0; color: var(--era); background: color-mix(in srgb, var(--era) 12%, transparent); }
  .band-head h2 { margin: .6rem 0 .4rem; color: var(--era); font-size: clamp(1.8rem, 3.5vw, 2.4rem); }
  .band-head p { margin: 1rem 0 0; color: var(--muted); }

  .events { list-style: none; margin: 0; padding: 0 0 2rem; position: relative; }
  .events::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 3px; transform: translateX(-50%); background: linear-gradient(var(--era), color-mix(in srgb, var(--era) 30%, transparent)); }
  .event {
    position: relative; display: grid; grid-template-columns: 1fr 64px 1fr; align-items: start; margin-bottom: 1.5rem;
    content-visibility: auto; contain-intrinsic-size: auto 150px;
  }
  /* desktop: interleave left/right cards so each side's card sits beside the gap of the other side */
  @media (min-width: 861px) {
    .event:not([hidden]) ~ .event:not([hidden]) { margin-top: -5.5rem; }
  }
  /* year sits above its own card, on the spine side; the opposite column stays empty so rows can interleave */
  .dot { grid-column: 2; grid-row: 1; justify-self: center; align-self: center; width: 18px; height: 18px; border-radius: 50%; background: var(--card); border: 4px solid var(--era); z-index: 1; transition: transform .2s ease, background .2s ease; }
  .event:hover .dot { transform: scale(1.25); background: var(--era); }
  .year { grid-row: 1; font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; color: var(--era); line-height: 1.3; margin-bottom: .4rem; }
  .ev-cell { grid-row: 2; position: relative; min-width: 0; }
  .left .ev-cell, .left .year { grid-column: 1; }
  .left .year { text-align: right; }
  .right .ev-cell, .right .year { grid-column: 3; }
  .ev-card {
    display: grid; grid-template-columns: 128px 1fr; gap: 1rem; text-decoration: none; color: var(--fg);
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: .8rem; box-shadow: var(--shadow);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s;
  }
  .ev-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: var(--era); }
  .ev-card img, .noimg { width: 128px; height: 100%; min-height: 96px; object-fit: cover; border-radius: var(--radius-sm); }
  .noimg { background: linear-gradient(135deg, color-mix(in srgb, var(--era) 30%, var(--card)), color-mix(in srgb, var(--era) 8%, var(--card))); }
  .ev-body { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .when { font-size: .875rem; font-weight: 700; color: var(--era); }
  .ev-body strong { font-family: var(--font-display); font-size: 1.12rem; line-height: 1.35; transition: color .2s; }
  .ev-card:hover strong { color: var(--accent); }
  .saar { font-size: .9rem; color: var(--muted); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .read { display: none; align-self: flex-start; font-size: .875rem; font-weight: 700; color: #15803d; background: #dcfce7; padding: 0 .45rem; }
  .is-read .read { display: inline-block; }
  .empty { text-align: center; color: var(--muted); padding: 3rem 0; }

  .has-audio .ev-body { padding-right: 2.6rem; }
  .listen {
    position: absolute; right: .6rem; bottom: .6rem; width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer;
    display: grid; place-items: center; color: #fff; background: var(--era); box-shadow: var(--shadow);
    transition: transform .15s ease, filter .15s ease;
  }
  .listen:hover { transform: scale(1.08); filter: brightness(1.1); }
  .listen:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
