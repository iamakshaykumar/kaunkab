---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Ornament from './Ornament.astro';
interface Props {
  title: string;
  kicker?: string;
  lead?: string;
  image?: string;
  era?: string;
}
const { title, kicker, lead, image, era } = Astro.props;
/** mobile variant made by scripts/optimize-images.mjs */
const small = image?.replace(/\.webp$/, '-sm.webp');
const srcset =
  image && small && small !== image && existsSync(join(process.cwd(), 'public', small)) ? `${small} 640w, ${image} 1200w` : undefined;
---
<section class:list={['page-hero', image && 'has-img', era && `era-${era}`]}>
  {image && <img class="bg" src={image} srcset={srcset} sizes="100vw" alt="" width="1600" height="900" fetchpriority="high" />}
  <div class="container inner">
    {kicker && <p class="pk">{kicker}</p>}
    <h1>{title}</h1>
    <Ornament light={!!image} align="left" />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative; isolation: isolate; overflow: hidden; padding: clamp(1.75rem, 4vw, 3rem) 0 clamp(1.5rem, 3vw, 2.25rem);
    background: radial-gradient(800px 300px at 10% 0%, color-mix(in srgb, var(--era, var(--accent)) 14%, transparent), transparent), var(--bg-alt);
    border-bottom: 1px solid var(--border); margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .page-hero.has-img { color: #fff; background: var(--ink); border-bottom: 0; min-height: clamp(240px, 34vh, 320px); display: flex; align-items: flex-end; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .has-img::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgba(12, 8, 5, .85), rgba(12, 8, 5, .45) 60%, rgba(12, 8, 5, .2)), linear-gradient(0deg, rgba(12, 8, 5, .6), transparent 60%);
  }
  .pk { margin: 0 0 .4rem; font-size: .875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--era, var(--accent)); }
  .has-img .pk { color: #fdba74; }
  h1 { margin: 0 0 .25rem; font-size: clamp(1.9rem, 4.5vw, 3rem); line-height: 1.2; }
  .lead { margin: .75rem 0 0; font-size: clamp(1rem, 1.6vw, 1.15rem); max-width: 68ch; line-height: 1.7; color: var(--muted); }
  @media (max-width: 640px) {
    .page-hero :global(.ornament) { display: none; }
    .lead { margin-top: .4rem; }
  }
  .has-img .lead { color: rgba(255, 255, 255, .88); }
</style>
