---
import { t } from '../i18n/hi';
---
<section class="otd" data-on-this-day aria-live="polite">
  <div class="head">
    <span class="icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
    </span>
    <div>
      <p class="kicker" data-heading>{t.onThisDay}</p>
      <p class="date" data-date>&nbsp;</p>
    </div>
  </div>
  <div data-body class="body"><div class="skeleton"></div></div>
</section>

<script>
  import { pickOnThisDay, type DayEvent } from '../lib/onThisDay';
  import { formatDayMonth, formatYear } from '../lib/dates';

  const root = document.querySelector<HTMLElement>('[data-on-this-day]');
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  async function load() {
    if (!root) return;
    const body = root.querySelector<HTMLElement>('[data-body]')!;
    const heading = root.querySelector<HTMLElement>('[data-heading]')!;
    const dateEl = root.querySelector<HTMLElement>('[data-date]')!;
    try {
      const events: DayEvent[] = await (await fetch('/data/aaj.json')).json();
      const r = pickOnThisDay(events, new Date());
      if (!r) {
        body.innerHTML = '<p class="empty">अभी कोई तारीख़ वाली घटना नहीं है।</p>';
        return;
      }
      heading.textContent = r.exact ? 'आज के दिन' : 'आने वाली तारीख़';
      dateEl.textContent = formatDayMonth(r.month, r.day);
      body.innerHTML = r.events
        .map(
          (e) => `<a class="ev" href="/lekh/${esc(e.slug)}">
            ${e.img ? `<img src="${esc(e.img)}" alt="" width="640" height="360" loading="lazy" />` : ''}
            <span class="txt">
              <span class="yr">${esc(formatYear(e.year))}</span>
              <strong>${esc(e.title)}</strong>
              <span class="saar">${esc(e.saar)}</span>
            </span></a>`,
        )
        .join('');
    } catch {
      body.innerHTML = '<p class="empty">अभी जानकारी लोड नहीं हो सकी।</p>';
    }
  }
  load();
</script>

<style>
  .otd {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 1.5rem; display: flex; flex-direction: column; gap: 1.1rem;
  }
  .head { display: flex; align-items: center; gap: .85rem; }
  .icon { width: 46px; height: 46px; border-radius: 0; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); flex: none; }
  .kicker { margin: 0; }
  .date { margin: 0; font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
  .skeleton { height: 120px; border-radius: var(--radius-sm); background: var(--bg-alt); }
  .body :global(.ev) { display: grid; grid-template-columns: 150px 1fr; gap: 1rem; text-decoration: none; color: var(--fg); align-items: start; }
  .body :global(.ev + .ev) { border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1rem; }
  .body :global(.ev img) { width: 150px; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-sm); }
  .body :global(.txt) { display: flex; flex-direction: column; gap: .2rem; }
  .body :global(.yr) { font-size: .85rem; font-weight: 700; color: var(--accent); }
  .body :global(.ev strong) { font-family: var(--font-display); font-size: 1.2rem; line-height: 1.35; }
  .body :global(.ev:hover strong) { color: var(--accent); }
  .body :global(.saar) { color: var(--muted); font-size: .95rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .body :global(.empty) { color: var(--muted); margin: 0; }
  @media (max-width: 520px) {
    .body :global(.ev) { grid-template-columns: 1fr; }
    .body :global(.ev img) { width: 100%; }
  }
</style>
