---
import { langFromUrl, localize, pick, ui } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = ui(lang);
const s = pick(lang);
const L = (p: string) => localize(p, lang);
interface Props {
  href: string;
}
const { href } = Astro.props;
---
<div class="edit">
  <div>
    <p class="h">{s("कोई गलती दिखी या कुछ जोड़ना चाहते हैं?", "Spotted a mistake or want to add something?")}</p>
    <p class="muted">{s("यह लेख समुदाय द्वारा लिखा गया है। आप भी इसे बेहतर बना सकते हैं।", "This article is written by the community. You can help make it better.")}</p>
  </div>
  <div class="actions">
    <a class="btn" href={href} rel="noopener" target="_blank">{t.editPage}</a>
    <a class="how" href={L("/yogdan/")}>{s("कैसे?", "How?")}</a>
  </div>
</div>

<style>
  .edit {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-top: 2rem; padding: 1.25rem 1.5rem; border: 1px dashed var(--border); border-radius: var(--radius);
  }
  .h { margin: 0; font-weight: 700; }
  .muted { margin: .15rem 0 0; font-size: .92rem; }
  .actions { display: flex; align-items: center; gap: 1rem; }
  .how { font-size: .92rem; }
</style>
