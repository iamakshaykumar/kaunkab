---
import { t } from '../i18n/hi';
const links = [
  { href: '/kaal/prachin', label: t.prachin },
  { href: '/kaal/madhyakaal', label: t.madhyakaal },
  { href: '/kaal/adhunik', label: t.adhunik },
  { href: '/timeline', label: t.timeline },
  { href: '/series', label: t.series },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label={`${t.siteName} — मुखपृष्ठ`}>
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34">
          <circle cx="20" cy="20" r="19" fill="var(--accent)" />
          <circle cx="20" cy="20" r="13" fill="none" stroke="var(--on-accent)" stroke-width="1.5" stroke-dasharray="2 3" />
          <path d="M20 9v11l7 4" fill="none" stroke="var(--on-accent)" stroke-width="2.4" stroke-linecap="round" />
        </svg>
      </span>
      <span class="word">कौन<b>कब</b></span>
    </a>

    <nav class="nav" aria-label="मुख्य">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="tools">
      <a href="/khoj" class="search-pill" aria-label={t.search}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>{t.search}</span>
      </a>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label={t.theme} title={t.theme}>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a href="/yogdan" class="btn btn-primary contribute-btn">{t.contribute}</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('kaunkab:theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 2rem; min-height: 72px; }
  .logo { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; color: var(--fg); flex: none; }
  .mark { display: inline-flex; }
  .word { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; line-height: 1; }
  .word b { color: var(--accent); font-weight: 700; }
  .nav { display: flex; gap: .25rem; flex: 1; }
  .nav a {
    position: relative; color: var(--fg); text-decoration: none; font-size: 1.02rem; font-weight: 500;
    padding: .45rem .8rem; border-radius: 0; opacity: .8; transition: opacity .15s, background .15s;
  }
  .nav a:hover { opacity: 1; background: var(--bg-alt); }
  .nav a[aria-current='page'] { opacity: 1; color: var(--accent); background: var(--accent-soft); }
  .tools { display: flex; align-items: center; gap: .5rem; margin-left: auto; }
  .search-pill {
    display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: 0;
    border: 1px solid var(--border); background: var(--card); color: var(--muted); text-decoration: none; font-size: .95rem;
    min-width: 150px; transition: border-color .15s;
  }
  .search-pill:hover { border-color: var(--accent); color: var(--fg); }
  .icon-btn {
    display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 0;
    border: 1px solid var(--border); background: var(--card); color: var(--fg); cursor: pointer;
  }
  .icon-btn:hover { border-color: var(--accent); }
  .contribute-btn { padding: .5rem 1.1rem; font-size: .95rem; }

  @media (max-width: 1080px) {
    .search-pill { min-width: 0; }
    .search-pill span { display: none; }
  }
  @media (max-width: 860px) {
    .bar { flex-wrap: wrap; gap: .5rem 1rem; min-height: 60px; padding-top: .5rem; }
    .contribute-btn { display: none; }
    .nav {
      order: 3; flex-basis: 100%; overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px .6rem;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .nav::-webkit-scrollbar { display: none; }
    .nav a { white-space: nowrap; font-size: .98rem; }
  }
</style>
