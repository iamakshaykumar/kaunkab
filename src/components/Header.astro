---
import { LANG_META, langFromUrl, localize, pick, switchPath, ui } from '../i18n';
import { ERAS, eraLabel, eraRangeLabel } from '../lib/eras';
interface Props {
  /** false when this page has no counterpart in the other language: the switch then goes to that language's home */
  translated?: boolean;
}
const { translated = true } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui(lang);
const s = pick(lang);
const L = (p: string) => localize(p, lang);
const other = lang === 'en' ? 'hi' : 'en';
const otherHref = translated ? switchPath(Astro.url.pathname, other) : localize('/', other);
const links = [
  { href: L('/kaal/prachin/'), label: t.prachin },
  { href: L('/kaal/madhyakaal/'), label: t.madhyakaal },
  { href: L('/kaal/adhunik/'), label: t.adhunik },
  { href: L('/timeline/'), label: t.timeline },
  { href: L('/suno/'), label: t.audiobook },
  { href: L('/series/'), label: t.series },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---
<header class="site-header">
  <div class="container bar">
    <a href={L('/')} class="logo" aria-label={`${t.siteName} — ${s('मुखपृष्ठ', 'home')}`}>
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34">
          <circle cx="20" cy="20" r="19" fill="var(--accent)" />
          <circle cx="20" cy="20" r="13" fill="none" stroke="var(--on-accent)" stroke-width="1.5" stroke-dasharray="2 3" />
          <path d="M20 9v11l7 4" fill="none" stroke="var(--on-accent)" stroke-width="2.4" stroke-linecap="round" />
        </svg>
      </span>
      <span class="word">{s('कौन', 'Kaun')}<b>{s('कब', 'Kab')}</b></span>
    </a>

    <nav class="nav" aria-label={s('मुख्य', 'Main')}>
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href)}>{l.label}</a>
      ))}
    </nav>

    <div class="tools">
      <a href={L('/khoj/')} class="search-pill" aria-label={t.search}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>{t.search}</span>
      </a>
      <a class="lang-btn" href={otherHref} hreflang={LANG_META[other].html} lang={LANG_META[other].html} data-lang-switch={other}
        title={s('Read in English', 'हिंदी में पढ़ें')} aria-label={s('Read in English', 'हिंदी में पढ़ें')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
        <span>{LANG_META[other].short}</span>
      </a>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label={t.theme} title={t.theme}>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href={L('/yogdan/')} class="btn btn-primary contribute-btn">{t.contribute}</a>
      <button type="button" class="icon-btn menu-btn" aria-label={s('मेनू खोलें', 'Open menu')} aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-menu-open>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- mobile menu: a native modal dialog (focus trap, Esc, inert page) outside the header,
     because the header's backdrop-filter would otherwise trap position: fixed -->
<dialog class="menu" id="site-menu" aria-label={s('मेनू', 'Menu')} data-menu>
  <div class="menu-panel">
    <div class="menu-top">
      <span class="word">{s('कौन', 'Kaun')}<b>{s('कब', 'Kab')}</b></span>
      <button type="button" class="icon-btn" aria-label={s('मेनू बंद करें', 'Close menu')} data-menu-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <form class="menu-search" action={L('/khoj/')} method="get" role="search">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <label class="sr-only" for="menu-q">{t.search}</label>
      <input id="menu-q" name="q" type="search" placeholder={s('व्यक्ति, जगह या साल खोजें…', 'Search a person, place or year…')} autocomplete="off" />
    </form>

    <p class="menu-h">{t.eras}</p>
    <nav aria-label={t.eras}>
      <ul class="menu-eras">
        {ERAS.map((e) => (
          <li>
            <a class={`era-${e.id}`} href={L(`/kaal/${e.id}/`)} aria-current={isCurrent(L(`/kaal/${e.id}/`))}>
              <span class="era-dot"></span>
              <span class="lbl">{eraLabel(e.id, lang)}</span>
              <span class="rng">{eraRangeLabel(e.id, lang)}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="menu-h">{s('पढ़ें', 'Read')}</p>
    <nav aria-label={s('पढ़ें', 'Read')}>
      <ul class="menu-links">
        <li><a href={L('/timeline/')} aria-current={isCurrent(L('/timeline/'))}>{t.timeline}<span aria-hidden="true">→</span></a></li>
        <li><a href={L('/suno/')} aria-current={isCurrent(L('/suno/'))}>{t.audiobook}<span aria-hidden="true">→</span></a></li>
        <li><a href={L('/series/')} aria-current={isCurrent(L('/series/'))}>{t.allSeries}<span aria-hidden="true">→</span></a></li>
        <li><a href={L('/parichay/')} aria-current={isCurrent(L('/parichay/'))}>{t.about}<span aria-hidden="true">→</span></a></li>
      </ul>
    </nav>

    <a class="menu-lang" href={otherHref} hreflang={LANG_META[other].html} lang={LANG_META[other].html} data-lang-switch={other}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
      {s('Read in English', 'हिंदी में पढ़ें')}
    </a>
    <a href={L('/yogdan/')} class="btn btn-primary menu-cta">{t.contribute} →</a>
    <div class="jaali" aria-hidden="true"></div>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('kaunkab:lang', a.dataset.langSwitch!); } catch {} }),
  );
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('kaunkab:theme', next); } catch {}
  });
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (menu && openBtn) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const open = () => {
      menu.showModal();
      document.documentElement.classList.add('menu-open');
      openBtn.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      if (!menu.open || menu.classList.contains('closing')) return;
      const done = () => {
        menu.classList.remove('closing');
        menu.close();
      };
      if (reduce.matches) return done();
      menu.classList.add('closing');
      menu.addEventListener('animationend', done, { once: true });
      setTimeout(() => menu.open && done(), 400); // safety net if animationend never fires
    };
    menu.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-open');
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    openBtn.addEventListener('click', open);
    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    // Esc: animate out instead of the instant native close
    menu.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    // tap on the dimmed backdrop (the dialog box itself, outside the panel)
    menu.addEventListener('click', (e) => { if (e.target === menu) close(); });
    // close if the viewport grows past the mobile breakpoint
    matchMedia('(min-width: 861px)').addEventListener('change', (m) => { if (m.matches && menu.open) menu.close(); });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow .25s ease, background .25s ease;
  }
  .site-header.scrolled { box-shadow: 0 6px 24px rgba(31, 23, 18, .08); background: color-mix(in srgb, var(--bg) 92%, transparent); }
  .bar { display: flex; align-items: center; gap: 2rem; min-height: 72px; }
  .logo { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; color: var(--fg); flex: none; }
  .mark { display: inline-flex; }
  .word { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; line-height: 1; }
  .word b { color: var(--accent); font-weight: 700; }
  .nav { display: flex; gap: .25rem; flex: 1; }
  .nav a {
    position: relative; color: var(--fg); text-decoration: none; font-size: 1.02rem; font-weight: 500;
    padding: .45rem .8rem; border-radius: 0; opacity: .8; transition: opacity .15s, background .15s;
  }
  .nav a:hover { opacity: 1; background: var(--bg-alt); }
  .nav a[aria-current='page'] { opacity: 1; color: var(--accent); background: var(--accent-soft); }
  .tools { display: flex; align-items: center; gap: .5rem; margin-left: auto; }
  .search-pill {
    display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: 0;
    border: 1px solid var(--border); background: var(--card); color: var(--muted); text-decoration: none; font-size: .95rem;
    min-width: 150px; transition: border-color .15s;
  }
  .search-pill:hover { border-color: var(--accent); color: var(--fg); }
  .icon-btn {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 0;
    border: 1px solid var(--border); background: var(--card); color: var(--fg); cursor: pointer;
  }
  .icon-btn:hover { border-color: var(--accent); }
  .icon-btn svg { transition: transform .35s var(--ease-out); }
  #theme-toggle:hover svg { transform: rotate(-18deg); }
  .sun { display: none; }
  :global(:root[data-theme='dark']) .sun { display: block; }
  :global(:root[data-theme='dark']) .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun { display: block; }
    :global(:root:not([data-theme='light'])) .moon { display: none; }
  }
  .nav a::after {
    content: ''; position: absolute; left: .8rem; right: .8rem; bottom: .2rem; height: 2px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease-out);
  }
  .nav a:hover::after, .nav a[aria-current='page']::after { transform: scaleX(1); }
  .contribute-btn { padding: .5rem 1.1rem; font-size: .95rem; }
  .menu-btn { display: none; }

  @media (max-width: 1080px) {
    .search-pill { min-width: 0; padding: 0; width: 44px; height: 44px; justify-content: center; }
    .search-pill span { display: none; }
  }
  @media (max-width: 860px) {
    .bar { gap: 1rem; min-height: 64px; }
    .nav, .contribute-btn { display: none; }
    .menu-btn { display: inline-grid; }
    .word { font-size: 1.45rem; }
  }

  /* ---------- mobile drawer ---------- */
  .menu {
    position: fixed; inset: 0 0 0 auto; margin: 0; padding: 0; border: 0;
    width: min(380px, 88vw); height: 100%; max-height: none; max-width: none;
    background: var(--bg); color: var(--fg); box-shadow: -20px 0 60px rgba(0, 0, 0, .25);
    overflow: hidden auto; overscroll-behavior: contain;
  }
  .menu::backdrop { background: rgba(12, 8, 5, .55); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
  .menu[open] { animation: menu-in .32s var(--ease-out); }
  .menu[open]::backdrop { animation: fade-in .32s ease; }
  .menu.closing { animation: menu-out .22s ease-in forwards; }
  .menu.closing::backdrop { animation: fade-out .22s ease-in forwards; }
  @keyframes menu-in { from { transform: translateX(100%); } to { transform: none; } }
  @keyframes menu-out { from { transform: none; } to { transform: translateX(100%); } }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes fade-out { to { opacity: 0; } }

  .menu-panel {
    min-height: 100%; display: flex; flex-direction: column;
    padding: max(14px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) max(20px, env(safe-area-inset-bottom)) 20px;
  }
  .menu-top { display: flex; align-items: center; justify-content: space-between; min-height: 50px; margin-bottom: 1rem; }
  .menu-search {
    display: flex; align-items: center; gap: .6rem; padding: 0 .9rem; margin-bottom: 1.5rem;
    background: var(--card); border: 1px solid var(--border); color: var(--muted);
  }
  .menu-search:focus-within { border-color: var(--accent); }
  .menu-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; color: var(--fg); padding: .7rem 0; }
  .menu-h { margin: 0 0 .5rem; font-size: .875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .menu ul { list-style: none; margin: 0 0 1.5rem; padding: 0; }
  .menu-eras { display: grid; gap: .5rem; }
  .menu-eras a {
    display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: .25rem; padding: .75rem 1rem;
    background: var(--card); border: 1px solid var(--border); border-left: 4px solid var(--era);
    color: var(--fg); text-decoration: none; transition: background .15s, transform .15s;
  }
  .menu-eras a:active { transform: scale(.985); }
  .menu-eras .lbl { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; }
  .menu-eras .rng { grid-column: 2; font-size: .875rem; color: var(--muted); }
  .menu-eras a[aria-current='page'] { background: color-mix(in srgb, var(--era) 10%, var(--card)); }
  .menu-links a {
    display: flex; justify-content: space-between; align-items: center; padding: .85rem .25rem;
    border-bottom: 1px solid var(--border); color: var(--fg); text-decoration: none; font-size: 1.1rem; font-weight: 500;
  }
  .menu-links a span { color: var(--muted); transition: transform .2s var(--ease-out); }
  .menu-links a:hover span { transform: translateX(4px); color: var(--accent); }
  .menu-links a[aria-current='page'] { color: var(--accent); font-weight: 700; }
  .menu-cta { margin-top: auto; width: 100%; padding: .85rem; }
  .menu .jaali { margin-top: 1.25rem; }
  :global(html.menu-open) { overflow: hidden; }
  .lang-btn {
    display: inline-flex; align-items: center; gap: .35rem; height: 40px; padding: 0 .7rem; font-weight: 700; font-size: .9rem;
    color: var(--fg); text-decoration: none; border: 1px solid var(--border); background: var(--card); transition: border-color .15s, color .15s;
  }
  .lang-btn:hover { border-color: var(--accent); color: var(--accent); }
  .menu-lang {
    display: flex; align-items: center; gap: .5rem; margin: 1.25rem 0 .75rem; padding: .7rem .9rem; font-weight: 700;
    color: var(--fg); text-decoration: none; border: 1px solid var(--border); background: var(--card);
  }
</style>
