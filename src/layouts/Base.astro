---
import '@fontsource/mukta/400.css';
import '@fontsource/mukta/600.css';
import '@fontsource/mukta/700.css';
import '@fontsource/noto-serif-devanagari/400.css';
import '@fontsource/noto-serif-devanagari/700.css';
import '../styles/global.css';
import muktaFont from '@fontsource/mukta/files/mukta-devanagari-400-normal.woff2?url';
import serifFont from '@fontsource/noto-serif-devanagari/files/noto-serif-devanagari-devanagari-700-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANG_META, LANGS, langFromUrl, pick, switchPath, ui } from '../i18n';

import { findImage } from '../lib/images';
import { metaDescription } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** public URL of a page-specific share image */
  image?: string;
  /** og:type — "article" on /lekh/ pages */
  type?: 'website' | 'article';
  /** YYYY-MM-DD, for article:published_time / article:modified_time */
  published?: string;
  modified?: string;
  /** keep the page out of search results (and drop the canonical) */
  noindex?: boolean;
  /** schema.org JSON-LD object(s) rendered in <head> */
  jsonLd?: object | object[];
  /** LCP image to preload */
  preload?: { src: string; srcset?: string; sizes?: string };
  /** set false when this page has no version in the other language (no hreflang, no switcher target) */
  translated?: boolean;
}
const lang = langFromUrl(Astro.url);
const t = ui(lang);
const s = pick(lang);
const { title, description = t.tagline, image, type = 'website', published, modified, noindex = false, jsonLd, preload, translated = true } = Astro.props;
const shareImage = image ?? findImage('og-default');
const shareImageUrl = shareImage ? new URL(shareImage, Astro.site).href : undefined;
const fullTitle = title === t.siteName ? `${t.siteName} | ${s('भारतीय इतिहास सरल हिंदी में', 'Indian History in Simple English')}` : `${title} | ${t.siteName}`;
const desc = metaDescription(description);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
// hreflang: every page and its translation point at each other (like Wikipedia's language links)
const alternates = translated && !noindex ? LANGS.map((l) => ({ l, href: new URL(switchPath(Astro.url.pathname, l), Astro.site).href })) : [];
---
<!doctype html>
<html lang={LANG_META[lang].html}>
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager: the container script loads once the page is idle so it does not compete with first paint -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      (function () {
        var load = function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-5KH7FBJ3';
          document.head.appendChild(s);
        };
        var idle = function () { 'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1500); };
        document.readyState === 'complete' ? idle() : addEventListener('load', idle, { once: true });
      })();
    </script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf6ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14100d" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={LANG_META[a.l].html} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={muktaFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    {preload && (
      <link rel="preload" as="image" href={preload.src} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={t.siteName} href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={LANG_META[lang].og} />
    {translated && <meta property="og:locale:alternate" content={LANG_META[lang === 'en' ? 'hi' : 'en'].og} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    {type === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}
    {ldBlocks.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
    <script is:inline>
      try {
        const th = localStorage.getItem('kaunkab:theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5KH7FBJ3" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="skip-link" href="#main">{s('मुख्य सामग्री पर जाएँ', 'Skip to main content')}</a>
    <Header translated={translated} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <button type="button" class="to-top" aria-label={s('ऊपर जाएँ', 'Back to top')} title={s('ऊपर जाएँ', 'Back to top')}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
    <script>
      const toTop = document.querySelector<HTMLButtonElement>('.to-top');
      if (toTop) {
        let ticking = false;
        const sync = () => {
          toTop.classList.toggle('show', scrollY > innerHeight * 1.2);
          ticking = false;
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } }, { passive: true });
        toTop.addEventListener('click', () => scrollTo({ top: 0 }));
        sync();
      }
    </script>
  </body>
</html>
