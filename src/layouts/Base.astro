---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/hi';

import { findImage } from '../lib/images';

interface Props {
  title: string;
  description?: string;
  /** public URL of a page-specific share image */
  image?: string;
}
const { title, description = t.tagline, image } = Astro.props;
const shareImage = image ?? findImage('og-default');
const fullTitle = title === t.siteName ? `${t.siteName} — ${t.tagline}` : `${title} | ${t.siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="hi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf6ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14100d" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={t.siteName} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={new URL(shareImage, Astro.site)} />}
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700&family=Noto+Serif+Devanagari:wght@400;600;700&display=swap"
    />
    <script is:inline>
      try {
        const th = localStorage.getItem('kaunkab:theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">मुख्य सामग्री पर जाएँ</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <button type="button" class="to-top" aria-label="ऊपर जाएँ" title="ऊपर जाएँ">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
    <script>
      const toTop = document.querySelector<HTMLButtonElement>('.to-top');
      if (toTop) {
        let ticking = false;
        const sync = () => {
          toTop.classList.toggle('show', scrollY > innerHeight * 1.2);
          ticking = false;
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } }, { passive: true });
        toTop.addEventListener('click', () => scrollTo({ top: 0 }));
        sync();
      }
    </script>
  </body>
</html>
