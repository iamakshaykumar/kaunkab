---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import Sources from '../../components/Sources.astro';
import Quiz from '../../components/Quiz.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import EditLink from '../../components/EditLink.astro';
import MarkRead from '../../components/MarkRead.astro';
import Ornament from '../../components/Ornament.astro';
import { articleUrl, editUrl, getArticles, getSeriesArticles, slugOf, type Article } from '../../lib/content';
import { crossLinksFor } from '../../lib/crossLinks';
import { relatedArticles } from '../../lib/related';
import { t } from '../../i18n/hi';
import { findImage } from '../../lib/images';
import { eraTitle } from '../../lib/eras';
import { LICENSE, ORG_NAME, abs, breadcrumb, isoDate, siteBase } from '../../lib/seo';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: slugOf(article) }, props: { article, articles } }));
}

interface Props {
  article: Article;
  articles: Article[];
}
const { article, articles } = Astro.props;
const d = article.data;
const { Content, headings } = await render(article);
const words = (article.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 180));

const series = d.series ? await getEntry('series', `hi/${d.series.id}`) : undefined;
const seriesArticles = d.series ? await getSeriesArticles(d.series.id) : [];

const flat = (a: Article) => ({
  id: a.id,
  era: a.data.era,
  tags: a.data.tags,
  kaun: a.data.kaun,
  kahan: a.data.kahan,
  series: a.data.series,
  entry: a,
});
const bySlug = new Map(articles.map((a) => [slugOf(a), a]));
const seeAlso = crossLinksFor(slugOf(article)).map((s) => {
  const a = bySlug.get(s);
  if (!a) throw new Error(`crossLinks.ts: unknown article slug "${s}"`);
  return a;
});
const seeAlsoIds = new Set(seeAlso.map((a) => a.id));
const related = relatedArticles(flat(article), articles.filter((a) => !seeAlsoIds.has(a.id)).map(flat), 3).map((x) => x.entry);

// ---- SEO: share image, LCP preload, JSON-LD ----
const slug = slugOf(article);
const imgPath = d.image?.src ?? findImage(`lekh/${slug}`);
const imgMd = findImage(`lekh/${slug}-md`);
const imgSm = findImage(`lekh/${slug}-sm`);
const bannerSrcset = imgPath && imgMd && imgSm ? `${imgSm} 640w, ${imgMd} 960w, ${imgPath} 1600w` : undefined;
const bannerSizes = '(max-width: 1000px) 100vw, 840px';
const site = siteBase(Astro.site);
const url = `${site}/lekh/${slug}/`;
const published = isoDate(d.published);
const modified = isoDate(d.updated ?? d.published);
const person = (name: string) => ({ '@type': 'Person', name });
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': url,
        ...(d.reviewedBy ? { reviewedBy: person(d.reviewedBy), lastReviewed: modified } : {}),
      },
      headline: d.title,
      description: d.description ?? d.saar,
      inLanguage: 'hi',
      datePublished: published,
      dateModified: modified,
      image: [abs(imgPath ?? '/images/og-default.jpg', site)],
      author: d.author ? person(d.author) : { '@type': 'Organization', '@id': `${site}/#organization`, name: ORG_NAME, url: `${site}/` },
      publisher: { '@type': 'Organization', '@id': `${site}/#organization`, name: ORG_NAME, logo: { '@type': 'ImageObject', url: `${site}/logo.png` } },
      isPartOf: series
        ? [{ '@id': `${site}/#website` }, { '@type': 'CreativeWorkSeries', name: series.data.title, url: `${site}/series/${d.series!.id}/` }]
        : { '@id': `${site}/#website` },
      ...(d.series ? { position: d.series.order } : {}),
      isAccessibleForFree: true,
      license: LICENSE,
      wordCount: words,
      timeRequired: `PT${readingMinutes}M`,
      ...(d.tags?.length ? { keywords: d.tags.join(', ') } : {}),
      articleSection: eraTitle(d.era),
      about: [
        ...(d.wikidata ? [{ '@type': 'Thing', name: d.title.split(/\s+—\s+|:\s/)[0], sameAs: `https://www.wikidata.org/wiki/${d.wikidata}` }] : []),
        ...(d.kaun ?? []).map((name) => ({ '@type': 'Person', name })),
        ...(d.kahan ?? []).map((name) => ({ '@type': 'Place', name })),
      ],
      citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, ...(s.url ? { url: s.url } : {}) })),
    },
    breadcrumb([
      { name: ORG_NAME, url: `${site}/` },
      { name: eraTitle(d.era), url: `${site}/kaal/${d.era}/` },
      ...(series ? [{ name: series.data.title, url: `${site}/series/${d.series!.id}/` }] : []),
      { name: d.title, url },
    ]),
  ],
};
---
<Base
  title={d.title}
  description={d.description ?? d.saar}
  image={imgPath}
  type="article"
  published={published}
  modified={modified}
  jsonLd={jsonLd}
  preload={imgPath ? { src: imgPath, srcset: bannerSrcset, sizes: bannerSizes } : undefined}
>
  <div class="progress-bar" aria-hidden="true"><span></span></div>
  <article class="container" data-pagefind-body>
    <ArticleHeader article={article} readingMinutes={readingMinutes} srcset={bannerSrcset} sizes={bannerSizes} series={series ? { title: series.data.title, id: d.series!.id } : undefined} />

    <div class="layout">
      <div class="main">
        <div class="prose">
          <Content />
          {seeAlso.length > 0 && (
            <aside class="see-also" aria-label="यह भी पढ़ें">
              <p class="kicker">यह भी पढ़ें</p>
              <ul>
                {seeAlso.map((a) => <li><a href={articleUrl(a)}>{a.data.title}</a></li>)}
              </ul>
            </aside>
          )}
        </div>
        <Ornament />

        <div data-pagefind-ignore>
          <MarkRead slug={slugOf(article)} />
          {series && seriesArticles.length > 1 && (
            <SeriesNav series={series} articles={seriesArticles} currentId={article.id} />
          )}
          {d.quiz?.length ? <Quiz quiz={d.quiz} /> : null}
        </div>

        <Sources sources={d.sources} />
        <EditLink href={editUrl(article)} />
      </div>
      <div data-pagefind-ignore>
        <ArticleAside article={article} headings={headings} editHref={editUrl(article)} />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related" data-pagefind-ignore>
      <div class="container">
        <p class="kicker">आगे पढ़ें</p>
        <h2>{t.related}</h2>
        <div class="grid">
          {related.map((a) => <ArticleCard article={a} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('.progress-bar span');
  if (bar) {
    let ticking = false;
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, h.scrollTop / max) : 0})`;
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

<style>
  .progress-bar { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 30; }
  .progress-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--gold), var(--accent)); transform: scaleX(0); transform-origin: 0 50%; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 4rem; align-items: start; }
  .main { min-width: 0; }
  .see-also { margin: 2.5rem 0 0; padding: 1.1rem 1.4rem; background: var(--bg-alt); border-left: 3px solid var(--gold); font-family: var(--font-ui); font-size: 1rem; line-height: 1.6; }
  .see-also ul { margin: .25rem 0 0; padding-left: 1.2rem; }
  .see-also a { display: inline-flex; align-items: center; min-height: 44px; }
  .related { background: var(--bg-alt); border-top: 1px solid var(--border); padding: 3.5rem 0 1rem; margin-top: 4rem; }
  .related h2 { margin-top: 0; }
  @media (max-width: 1000px) {
    .layout { grid-template-columns: 1fr; gap: 0; }
    .layout > div:last-child { order: -1; margin-bottom: 2rem; }
  }
</style>
