---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProgressCount from '../../components/ProgressCount.astro';
import { getSeriesArticles, getSeriesList, slugOf } from '../../lib/content';
import { findImage } from '../../lib/images';
import { t } from '../../i18n/hi';

const list = await Promise.all(
  (await getSeriesList()).map(async (s) => {
    const id = s.id.replace(/^hi\//, '');
    return { s, id, img: findImage(`series/${id}`), items: await getSeriesArticles(id) };
  }),
);
---
<Base title={t.allSeries} description="एक के बाद एक पढ़ने के लिए चुनी गई लेख शृंखलाएँ।">
  <PageHero kicker="क्रम से पढ़ें" title={t.allSeries} lead="एक विषय को शुरू से अंत तक समझने के लिए लेखों को क्रम से पढ़ें। हर शृंखला में आपकी प्रगति अपने आप सेव होती है।" />
  <div class="container list">
    {list.map(({ s, id, img, items }) => (
      <a class="row" href={`/series/${id}`}>
        <div class="media">{img && <img src={img} alt="" width="1200" height="675" loading="lazy" />}</div>
        <div class="body">
          <p class="kicker">{items.length} भाग</p>
          <h2>{s.data.title}</h2>
          <p class="muted">{s.data.description}</p>
          <ol>{items.map((a) => <li>{a.data.title}</li>)}</ol>
          <span class="foot"><ProgressCount slugs={items.map(slugOf)} /><span class="link-arrow">शुरू करें →</span></span>
        </div>
      </a>
    ))}
  </div>
</Base>

<style>
  .list { display: grid; gap: 1.5rem; }
  .row {
    display: grid; grid-template-columns: 1fr 1.1fr; overflow: hidden; text-decoration: none; color: var(--fg);
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); transition: box-shadow .2s, transform .2s;
  }
  .row:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .media { background: var(--bg-alt); min-height: 260px; }
  .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 2rem; display: flex; flex-direction: column; gap: .4rem; }
  h2 { margin: 0; }
  .muted { margin: 0; }
  ol { margin: .75rem 0 0; padding-left: 1.2rem; font-weight: 500; display: grid; gap: .2rem; }
  .foot { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 1.25rem; }
  @media (max-width: 800px) { .row { grid-template-columns: 1fr; } .media { min-height: 0; aspect-ratio: 16 / 9; } }
</style>
