---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProgressCount from '../../components/ProgressCount.astro';
import { articleUrl, getSeriesArticles, getSeriesList, slugOf, type Article, type Series } from '../../lib/content';
import { formatKab } from '../../lib/dates';
import { findImage } from '../../lib/images';
import { render } from 'astro:content';
import { ORG_NAME, abs, breadcrumb, siteBase } from '../../lib/seo';

export async function getStaticPaths() {
  const list = await getSeriesList();
  return Promise.all(
    list.map(async (series) => {
      const id = series.id.replace(/^hi\//, '');
      return { params: { id }, props: { series, id, items: await getSeriesArticles(id) } };
    }),
  );
}

interface Props {
  series: Series;
  id: string;
  items: Article[];
}
const { series, id, items } = Astro.props;
const img = findImage(`series/${id}`);
/** optional intro written in the series file body */
const hasIntro = !!series.body?.trim();
const { Content: Intro } = await render(series);

const site = siteBase(Astro.site);
const url = `${site}/series/${id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': url,
      url,
      name: series.data.title,
      description: series.data.description,
      inLanguage: 'hi',
      isPartOf: { '@id': `${site}/#website` },
      ...(img ? { image: abs(img, site) } : {}),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: items.length,
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        itemListElement: items.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site}${articleUrl(a)}`, name: a.data.title })),
      },
    },
    breadcrumb([
      { name: ORG_NAME, url: `${site}/` },
      { name: 'सभी शृंखलाएँ', url: `${site}/series/` },
      { name: series.data.title, url },
    ]),
  ],
};
---
<Base title={series.data.title} description={series.data.description} image={img} jsonLd={jsonLd}>
  <PageHero kicker={`शृंखला · ${items.length} भाग`} title={series.data.title} lead={series.data.description} image={img}>
    <div class="hero-actions">
      {items[0] && <a class="btn btn-primary" href={articleUrl(items[0])}>भाग 1 से शुरू करें →</a>}
      <a class:list={['btn', img ? 'btn-ghost-light' : '']} href={`/suno/?s=${id}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"/></svg>
        यह शृंखला सुनें
      </a>
      <ProgressCount slugs={items.map(slugOf)} />
    </div>
  </PageHero>
  <div class="container">
    {hasIntro && <div class="prose intro"><Intro /></div>}
    <ol class="steps">
      {items.map((a, i) => {
        const thumb = findImage(`lekh/${slugOf(a)}-sm`) ?? findImage(`lekh/${slugOf(a)}`);
        return (
          <li class={`era-${a.data.era}`} data-slug={slugOf(a)}>
            <span class="num diamond">{i + 1}</span>
            <a class="step" href={articleUrl(a)}>
              {thumb && <img src={thumb} alt="" width="640" height="360" loading="lazy" />}
              <span class="txt">
                <span class="when">{formatKab(a.data.kab)}</span>
                <strong>{a.data.title}</strong>
                <span class="muted">{a.data.saar}</span>
                <span class="read">पढ़ा हुआ</span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
    <p><a href="/series/">← सभी शृंखलाएँ</a></p>
  </div>
</Base>

<script>
  import { browserProgress } from '../../lib/progress';
  const read = new Set(browserProgress().getRead());
  document.querySelectorAll<HTMLElement>('.steps li[data-slug]').forEach((el) => {
    if (read.has(el.dataset.slug!)) el.classList.add('is-read');
  });
</script>

<style>
  .intro { margin: 0 0 2.5rem; }
  .hero-actions { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .steps { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 1.25rem; position: relative; }
  .steps::before { content: ''; position: absolute; left: 1.2rem; top: 1rem; bottom: 1rem; width: 2px; background: var(--border); }
  .steps li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1.25rem; align-items: center; position: relative; }
  .num { width: 2.6rem; height: 2.6rem; background: var(--era); color: var(--on-accent); z-index: 1; }
  .step {
    display: grid; grid-template-columns: 200px 1fr; gap: 1.25rem; text-decoration: none; color: var(--fg); align-items: center;
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; box-shadow: var(--shadow); transition: box-shadow .2s, transform .2s;
  }
  .step:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .step img { width: 200px; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-sm); }
  .txt { display: flex; flex-direction: column; gap: .25rem; }
  .when { font-size: .85rem; font-weight: 700; color: var(--era); }
  .txt strong { font-family: var(--font-display); font-size: 1.3rem; }
  .txt .muted { font-size: .95rem; }
  .step strong { transition: color .2s; }
  .step:hover strong { color: var(--accent); }
  .read { display: none; align-self: flex-start; font-size: .875rem; font-weight: 700; color: #15803d; background: #dcfce7; padding: 0 .45rem; }
  .is-read .read { display: inline-block; }
  .is-read .num { background: #15803d; }
  @media (max-width: 700px) {
    .steps li { grid-template-columns: 2rem 1fr; gap: .75rem; }
    .steps::before { left: 1rem; }
    .num { width: 2.1rem; height: 2.1rem; font-size: .85rem; }
    .step { grid-template-columns: 88px 1fr; gap: .8rem; padding: .7rem; align-items: start; }
    .step img { width: 88px; aspect-ratio: 1; }
    .txt strong { font-size: 1.05rem; line-height: 1.35; }
    .txt .muted { font-size: .86rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .when { font-size: .875rem; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  }
</style>
