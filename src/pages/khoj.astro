---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { t } from '../i18n/hi';
---
<Base title={t.search} description="कौन कब के सभी लेखों में खोजें।" noindex>
  <PageHero kicker="खोज" title="क्या ढूँढ रहे हैं?" lead={'किसी व्यक्ति, स्थान, घटना या साल से खोजें — जैसे "अशोक", "1857", "पानीपत"।'} />
  <div class="container search-wrap">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
    <noscript><p>खोज के लिए JavaScript चालू करें।</p></noscript>
  </div>
</Base>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) {
      document.getElementById('search').innerHTML =
        '<p class="card">खोज केवल बिल्ड की गई साइट पर काम करती है (npm run build && npm run preview)।</p>';
      return;
    }
    const ui = new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: 'यहाँ लिखें…',
        clear_search: 'साफ़ करें',
        load_more: 'और परिणाम',
        search_label: 'इस साइट में खोजें',
        zero_results: '"[SEARCH_TERM]" के लिए कुछ नहीं मिला',
        many_results: '"[SEARCH_TERM]" के लिए [COUNT] परिणाम',
        one_result: '"[SEARCH_TERM]" के लिए [COUNT] परिणाम',
        searching: '"[SEARCH_TERM]" खोज रहे हैं…',
      },
    });
    document.querySelector('#search input')?.setAttribute('aria-label', 'कौन कब के लेखों में खोजें');
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  });
</script>

<style is:global>
  .search-wrap { max-width: 820px; min-height: 40vh; }
  #search {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--card);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--accent-soft);
    --pagefind-ui-font: var(--font-ui);
  }
</style>
