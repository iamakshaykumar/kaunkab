---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { langFromUrl, pick, ui } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = ui(lang);
const s = pick(lang);
const EN = lang === 'en';
---
<Base title={t.search} description={s("कौन कब के सभी लेखों में खोजें।", "Search every Kaun Kab article.")} noindex>
  <PageHero kicker={s("खोज", "Search")} title={s("क्या ढूँढ रहे हैं?", "What are you looking for?")} lead={s('किसी व्यक्ति, स्थान, घटना या साल से खोजें — जैसे "अशोक", "1857", "पानीपत"।', 'Search by person, place, event or year — for example "Ashoka", "1857", "Panipat".')} />
  <div class="container search-wrap">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
    <noscript><p>{s('खोज के लिए JavaScript चालू करें।', 'Turn on JavaScript to search.')}</p></noscript>

    <section class="gsearch" aria-labelledby="gsearch-h">
      <h2 id="gsearch-h">{s("Google से खोजें", "Search with Google")}</h2>
      <div class="gcse-searchbox"></div>
      <div class="gcse-searchresults"></div>
    </section>
  </div>
</Base>

<script is:inline async src="https://cse.google.com/cse.js?cx=8047b218986f74198"></script>
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  var EN = document.documentElement.lang === 'en';
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) {
      document.getElementById('search').innerHTML =
        EN ? '<p class="card">Search works only on the built site (npm run build && npm run preview).</p>' : '<p class="card">खोज केवल बिल्ड की गई साइट पर काम करती है (npm run build && npm run preview)।</p>';
      return;
    }
    const ui = new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      translations: EN ? {
        placeholder: 'Type here…',
        clear_search: 'Clear',
        load_more: 'More results',
        search_label: 'Search this site',
        zero_results: 'Nothing found for "[SEARCH_TERM]"',
        many_results: '[COUNT] results for "[SEARCH_TERM]"',
        one_result: '[COUNT] result for "[SEARCH_TERM]"',
        searching: 'Searching for "[SEARCH_TERM]"…',
      } : {
        placeholder: 'यहाँ लिखें…',
        clear_search: 'साफ़ करें',
        load_more: 'और परिणाम',
        search_label: 'इस साइट में खोजें',
        zero_results: '"[SEARCH_TERM]" के लिए कुछ नहीं मिला',
        many_results: '"[SEARCH_TERM]" के लिए [COUNT] परिणाम',
        one_result: '"[SEARCH_TERM]" के लिए [COUNT] परिणाम',
        searching: '"[SEARCH_TERM]" खोज रहे हैं…',
      },
    });
    document.querySelector('#search input')?.setAttribute('aria-label', EN ? 'Search Kaun Kab articles' : 'कौन कब के लेखों में खोजें');
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  });
</script>

<style is:global>
  .search-wrap { max-width: 820px; min-height: 40vh; }
  .gsearch { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .gsearch h2 { font-size: 1.15rem; margin: 0 0 .75rem; }
  .gsearch .gsc-control-cse, .gsearch .gsc-control-wrapper-cse { background: transparent; border: 0; padding: 0; font-family: var(--font-ui); }
  .gsearch table { margin: 0; }
  #search {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--card);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--accent-soft);
    --pagefind-ui-font: var(--font-ui);
  }
</style>
