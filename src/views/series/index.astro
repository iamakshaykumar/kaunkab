---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProgressCount from '../../components/ProgressCount.astro';
import { getSeriesArticles, getSeriesList, slugOf } from '../../lib/content';
import { findImage } from '../../lib/images';
import { langFromUrl, localize, pick, ui } from '../../i18n';

const lang = langFromUrl(Astro.url);
const t = ui(lang);
const s = pick(lang);
const L = (p: string) => localize(p, lang);
const list = await Promise.all(
  (await getSeriesList(lang)).map(async (x) => {
    const id = x.id.replace(/^[a-z]{2}\//, '');
    return { s: x, id, img: findImage(`series/${id}`), items: await getSeriesArticles(id, lang) };
  }),
);
---
<Base title={t.allSeries} description={s("एक के बाद एक पढ़ने के लिए चुनी गई लेख शृंखलाएँ।", "Article series chosen to be read one after another.")}>
  <PageHero kicker={s("क्रम से पढ़ें", "Read in order")} title={t.allSeries} lead={s("एक विषय को शुरू से अंत तक समझने के लिए लेखों को क्रम से पढ़ें। हर शृंखला में आपकी प्रगति अपने आप सेव होती है।", "Read the articles in order to understand a topic from start to finish. Your progress in every series is saved automatically.")} />
  <div class="container list">
    {list.map(({ s, id, img, items }) => (
      <a class="row" href={L(`/series/${id}/`)}>
        <div class="media">{img && <img src={img} alt="" width="1200" height="675" loading="lazy" />}</div>
        <div class="body">
          <p class="kicker">{s.data.order ? `${pick(lang)("शृंखला", "Series")} ${s.data.order} · ` : ""}{items.length} {pick(lang)("भाग", "parts")}</p>
          <h2>{s.data.title}</h2>
          <p class="muted">{s.data.description}</p>
          <ol>
            {items.map((a) => <li>{a.data.title}</li>)}
            {items.length > 4 && <li class="more">{pick(lang)(`और ${items.length - 4} भाग…`, `and ${items.length - 4} more…`)}</li>}
          </ol>
          <span class="foot"><ProgressCount slugs={items.map(slugOf)} /><span class="link-arrow">{pick(lang)("शुरू करें →", "Start →")}</span></span>
        </div>
      </a>
    ))}
  </div>
</Base>

<style>
  .list { display: grid; gap: 1.5rem; }
  .row {
    display: grid; grid-template-columns: 1fr 1.1fr; overflow: hidden; text-decoration: none; color: var(--fg);
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); transition: box-shadow .2s, transform .2s;
  }
  .row:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .media { background: var(--bg-alt); min-height: 260px; }
  .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 2rem; display: flex; flex-direction: column; gap: .4rem; }
  h2 { margin: 0; }
  .muted { margin: 0; }
  ol { margin: .75rem 0 0; padding-left: 1.2rem; font-weight: 500; display: grid; gap: .2rem; }
  .foot { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 1.25rem; }
  .more { display: none; list-style: none; margin-left: -1.2rem; color: var(--muted); font-weight: 400; }
  .media { overflow: hidden; }
  .media img { transition: transform .6s var(--ease-out); }
  .row:hover .media img { transform: scale(1.04); }
  .row:hover h2 { color: var(--accent); }
  h2 { transition: color .2s; }
  @media (max-width: 800px) {
    .row { grid-template-columns: 1fr; }
    .media { min-height: 0; aspect-ratio: 16 / 9; }
    .body { padding: 1.25rem 1.3rem 1.4rem; }
    ol li:nth-child(n + 5):not(.more) { display: none; }
    .more { display: list-item; }
  }
</style>
