---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProgressCount from '../../components/ProgressCount.astro';
import { ERAS, eraBlurb, eraRangeLabel, eraTitle, type EraInfo } from '../../lib/eras';
import { langFromUrl, localize, pick, ui } from '../../i18n';
import { articleUrl, getArticles, getSeriesArticles, getSeriesList, slugOf } from '../../lib/content';
import { findImage } from '../../lib/images';
import { getEntry, render } from 'astro:content';
import { ORG_NAME, abs, breadcrumb, siteBase } from '../../lib/seo';

interface Props {
  era: EraInfo;
}
const { era } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui(lang);
const s = pick(lang);
const L = (p: string) => localize(p, lang);
const P = lang === 'en' ? '/en' : '';
const list = (await getArticles(lang)).filter((a) => a.data.era === era.id);
const others = ERAS.filter((e) => e.id !== era.id);

/** Series that have articles in this era, most articles first. */
const eraSeries = (
  await Promise.all(
    (await getSeriesList(lang)).map(async (x) => {
      const id = x.id.replace(/^[a-z]{2}\//, '');
      const items = await getSeriesArticles(id, lang);
      return { s: x, id, items, n: items.filter((a) => a.data.era === era.id).length };
    }),
  )
)
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n || (a.s.data.order ?? 999) - (b.s.data.order ?? 999));

const intro = await getEntry('kaal', era.id);
const Intro = intro?.body?.trim() ? (await render(intro)).Content : undefined;

const SEO_TITLE: Record<string, string> = lang === 'en' ? {
  prachin: 'History of Ancient India',
  madhyakaal: 'History of Medieval India',
  adhunik: 'History of Modern India',
} : {
  prachin: 'प्राचीन भारत का इतिहास',
  madhyakaal: 'मध्यकालीन भारत का इतिहास',
  adhunik: 'आधुनिक भारत का इतिहास',
};
const seoTitle = `${SEO_TITLE[era.id] ?? eraTitle(era.id, lang)} (${eraRangeLabel(era.id, lang)})`;
const seoDescription = s(`${era.blurb} ${list.length} लेख और ${eraSeries.length} शृंखलाएँ, सरल हिंदी में और स्रोतों के साथ।`, `${era.blurbEn} ${list.length} articles and ${eraSeries.length} series, in simple English with sources.`);
const img = findImage(`kaal/${era.id}`);

const site = siteBase(Astro.site);
const url = `${site}${P}/kaal/${era.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': url,
      url,
      name: SEO_TITLE[era.id] ?? eraTitle(era.id, lang),
      description: eraBlurb(era.id, lang),
      inLanguage: lang,
      isPartOf: { '@id': `${site}/#website` },
      ...(img ? { image: abs(img, site) } : {}),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: list.length,
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site}${articleUrl(a)}`, name: a.data.title })),
      },
    },
    breadcrumb([
      { name: t.siteName, url: `${site}${P}/` },
      { name: eraTitle(era.id, lang), url },
    ]),
  ],
};
---
<Base title={seoTitle} description={seoDescription} image={img} jsonLd={jsonLd}>
  <PageHero kicker={eraRangeLabel(era.id, lang)} title={eraTitle(era.id, lang)} lead={eraBlurb(era.id, lang)} image={img} era={era.id}>
    <p class="count">{list.length} {s("लेख", "articles")} <ProgressCount slugs={list.map(slugOf)} /></p>
  </PageHero>
  <div class="container">
    {Intro && <div class="prose era-intro"><Intro /></div>}

    {eraSeries.length > 0 && (
      <section class="era-series">
        <h2>{s(`${eraTitle(era.id)} की शृंखलाएँ`, `Series on ${eraTitle(era.id, lang)}`)}</h2>
        <p class="muted">{s("किसी विषय को शुरू से अंत तक समझना हो तो इन शृंखलाओं से शुरुआत करें।", "To understand a topic from start to finish, begin with these series.")}</p>
        <ul>
          {eraSeries.map(({ s: x, id, items }) => (
            <li>
              <a href={L(`/series/${id}/`)}>{x.data.title}</a>
              <span class="muted"> · {items.length} {s("भाग", "parts")}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <h2 class="all-h">{s(`${eraTitle(era.id)} के सभी लेख`, `All articles on ${eraTitle(era.id, lang)}`)}</h2>
    {list.length > 0 ? (
      <div data-era-list>
        <div class="toolbar">
          <label class="find">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="sr-only">{s("इस काल के लेखों में ढूँढें", "Search this era")}</span>
            <input type="search" placeholder={s(`${list.length} लेखों में ढूँढें…`, `Search ${list.length} articles…`)} data-find autocomplete="off" />
          </label>
          <div class="sort" role="group" aria-label={s("क्रम", "Order")}>
            <button type="button" class="active" data-sort="asc" aria-pressed="true">{s("पुराने पहले", "Oldest first")}</button>
            <button type="button" data-sort="desc" aria-pressed="false">{s("नए पहले", "Newest first")}</button>
          </div>
          <p class="status" aria-live="polite" data-status></p>
        </div>
        <div class="grid" data-grid>{list.map((a) => <ArticleCard article={a} />)}</div>
        <p class="empty card" hidden data-empty>{s("कोई लेख नहीं मिला। कोई और शब्द आज़माएँ।", "No articles found. Try another word.")}</p>
      </div>
    ) : (
      <p class="card">{s("इस काल में अभी कोई लेख नहीं है।", "No articles in this era yet.")} <a href={L("/yogdan/")}>{s("पहला लेख आप लिखिए!", "Write the first one!")}</a></p>
    )}

    <div class="others">
      {others.map((e) => (
        <a class={`other era-${e.id}`} href={L(`/kaal/${e.id}/`)}>
          <span class="muted">{eraRangeLabel(e.id, lang)}</span>
          <strong>{eraTitle(e.id, lang)} →</strong>
        </a>
      ))}
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-era-list]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const find = root.querySelector<HTMLInputElement>('[data-find]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const cards = [...grid.children] as HTMLElement[];
    const text = new Map(cards.map((c) => [c, (c.textContent ?? '').toLowerCase()]));
    let t: number | undefined;
    const apply = () => {
      const q = find.value.trim().toLowerCase();
      let n = 0;
      cards.forEach((c) => {
        const ok = !q || text.get(c)!.includes(q);
        c.hidden = !ok;
        if (ok) n++;
      });
      empty.hidden = n > 0;
      status.textContent = q ? `${n} ${document.documentElement.lang === 'en' ? 'articles found' : 'लेख मिले'}` : '';
    };
    find.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(apply, 120); });
    root.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b, _, all) =>
      b.addEventListener('click', () => {
        all.forEach((x) => { x.classList.toggle('active', x === b); x.setAttribute('aria-pressed', String(x === b)); });
        const order = b.dataset.sort === 'desc' ? [...cards].reverse() : cards;
        grid.append(...order);
      }),
    );
  }
</script>

<style>
  .era-intro { margin: 0 0 2.5rem; }
  .era-series { margin: 0 0 2.5rem; }
  .era-series h2, .all-h { margin: 0 0 .75rem; }
  .era-series ul { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); }
  .era-series li { border-bottom: 1px solid var(--border); }
  .era-series a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: none; }
  .era-series a:hover { text-decoration: underline; }
  .all-h { margin-top: 1rem; }
  .toolbar {
    position: sticky; top: var(--header-h); z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem;
    padding: .8rem 0; margin: -1rem 0 1.5rem; border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .find {
    display: flex; align-items: center; gap: .5rem; flex: 1; max-width: 420px; padding: 0 .85rem;
    background: var(--card); border: 1px solid var(--border); color: var(--muted); transition: border-color .15s;
  }
  .find:focus-within { border-color: var(--accent); }
  .find input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: .95rem; color: var(--fg); padding: .55rem 0; }
  .sort { display: inline-flex; margin-left: auto; border: 1px solid var(--border); background: var(--card); }
  .sort button { font: inherit; font-size: .9rem; font-weight: 600; padding: .45rem .9rem; border: 0; background: transparent; color: var(--muted); cursor: pointer; transition: background .15s, color .15s; }
  .sort button.active { background: var(--fg); color: var(--bg); }
  .status { margin: 0; flex-basis: 100%; font-size: .88rem; color: var(--muted); }
  .status:empty { display: none; }
  .grid > :global([hidden]) { display: none; }
  .empty { text-align: center; color: var(--muted); }
  @media (max-width: 560px) { .find { max-width: none; flex-basis: 100%; } .sort { margin-left: 0; } }
  .count { display: flex; align-items: center; gap: .6rem; margin: 1.25rem 0 0; font-weight: 600; }
  .others { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); margin-top: 3.5rem; }
  .other { display: flex; flex-direction: column; gap: .2rem; padding: 1.25rem 1.5rem; border-radius: var(--radius); border: 1px solid var(--border); background: var(--card); text-decoration: none; border-left: 5px solid var(--era); }
  .other strong { font-family: var(--font-display); font-size: 1.35rem; color: var(--era); }
  .other:hover { box-shadow: var(--shadow); }
</style>
